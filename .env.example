# ============================================================
# DocuTrade Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# ---- Database ----
DATABASE_URL=postgresql://postgres:123@localhost:5432/docutrade

# ---- Server ----
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
FRONTEND_URL=http://localhost:8080

# ---- Authentication ----
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRY_HOURS=24

# ---- Blockchain / Arbitrum ----
ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_CHAIN_ID=421614
BLOCKCHAIN_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ---- Smart Contract Addresses ----
ORGANIZATION_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
SHIPMENT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
DOCUMENT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
DOCUTRADE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
DOCUMENT_VERIFICATION_CONTRACT=0x0000000000000000000000000000000000000000

# ---- IPFS ----
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_URL=http://localhost:8081/ipfs

# ---- File Storage ----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ---- Rust Log ----
RUST_LOG=docutrade=debug,tower_http=debug

# ---- Kpler API Integration ----
KPLER_API_BASE_URL=https://api.kpler.com/v2/cargo
KPLER_API_KEY=YOUR_SECRET_KEY
